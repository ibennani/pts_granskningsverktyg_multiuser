{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "node .cursor/hooks/nabu_on_session_start.mjs"
      }
    ],
    "subagentStart": [
      {
        "command": "node .cursor/hooks/nabu_on_subagent_start.mjs"
      }
    ],
    "subagentStop": [
      {
        "command": "node .cursor/hooks/nabu_on_subagent_stop.mjs"
      }
    ],
    "postToolUse": [
      {
        "command": "node .cursor/hooks/nabu_on_todo_write.mjs",
        "matcher": "TodoWrite"
      },
      {
        "command": ".cursor/hooks/nabu-on-ask-question.cmd",
        "matcher": "AskQuestion"
      }
    ],
    "afterAgentResponse": [
      {
        "command": ".cursor/hooks/nabu-on-after-agent-response.cmd"
      }
    ],
    "stop": [
      {
        "command": ".cursor/hooks/nabu-on-agent-stop.cmd"
      }
    ]
  }
}
