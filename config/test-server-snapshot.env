# Sidrapport-inställningar för testservern (mer data, snällare mot målsajter).
# Mergas in i serverns .env vid deploy:test-server.
GV_SNAPSHOT_BROWSER_MAX_CONCURRENCY=1
GV_SNAPSHOT_PACKAGE_MAX_CONCURRENCY=2
GV_SNAPSHOT_EXTENDED_CDP_MAX_MS=20000
GV_SNAPSHOT_YIELD_ON_QUEUE=false
GV_SNAPSHOT_RESOURCE_TEXT_MAX_BYTES=5242880
GV_SNAPSHOT_HOST_MAX_CONCURRENCY=1
GV_SNAPSHOT_HOST_COOLDOWN_MS=3000
GV_SNAPSHOT_NETWORK_BUFFER_PER_RESOURCE=5242880
GV_SNAPSHOT_NETWORK_BUFFER_TOTAL=52428800
GV_SNAPSHOT_POST_NAVIGATION_SETTLE_MS=1500
